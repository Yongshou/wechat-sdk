{
  "name": "@shdr/wechat-sdk-api",
  "version": "1.0.22",
  "description": "WeChat API service package",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.umd.cjs",
  "module": "dist/index.es.js",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build --config ./vite.config.ts && tsc --emitDeclarationOnly --outDir ./dist || echo 'Type declaration generation failed'",
    "test": "jest",
    "install:nexus3": "pnpm config set registry https://nexus3.disney.com/repository/wdpr-ra-npm-group && pnpm config get registry && pnpm install --force && npm run build",
    "publish:nexus3": "pnpm publish --no-git-checks --registry=https://nexus3.disney.com/repository/wdpr-ra-npm-group",
    "release": "pnpm run release:api -w"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://nexus3.disney.com/repository/wdpr-ra-npm-group"
  },
  "keywords": [
    "wechat",
    "api",
    "service"
  ],
  "author": "Jimmy",
  "license": "MIT"
}
